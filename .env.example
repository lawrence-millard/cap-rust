# Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public URL for this server (where the Cap desktop app connects)
# e.g. https://cap.example.com
WEB_URL=http://localhost:8080

# Allow anyone to register via the desktop connect page. Set to false to
# restrict access to existing accounts only.
CAP_SIGNUPS=true

# Treat the owner as Pro (enables longer recordings, all features). Default: true.
CAP_PLAN_UPGRADED=true

# Long random string used to sign upload/playback URLs and JWT tokens
SIGN_SECRET=change-me-to-a-long-random-string

# JWT token lifetime in seconds (default: 30 days)
JWT_TTL=2592000

# Max DB pool connections (default: 5)
DB_MAX_CONNECTIONS=5

# Where recordings are stored on disk
STORAGE_DIR=./data

PORT=8080
RUST_LOG=info
