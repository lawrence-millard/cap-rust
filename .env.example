# Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public URL for this server (where the Cap desktop app connects)
# e.g. https://cap.example.com
WEB_URL=http://localhost:8080

# Allow anyone to register via the desktop connect page. Set to false to
# restrict access to existing accounts only. Prefer false for internet-facing hosts.
CAP_SIGNUPS=false

# Treat the owner as Pro (enables longer recordings, all features). Default: true.
CAP_PLAN_UPGRADED=true

# Long random string used to sign upload/playback URLs and JWT tokens.
# Generate with: openssl rand -hex 32
# Do not use placeholder values — the server refuses known weak secrets.
SIGN_SECRET=

# Optional extra CORS origins (comma-separated). WEB_URL is always allowed.
# CORS_ORIGINS=https://app.example.com

# JWT token lifetime in seconds (default: 30 days)
JWT_TTL=2592000

# Max DB pool connections (default: 5)
DB_MAX_CONNECTIONS=5

# Storage selector. S3 is beta for direct desktopMP4 uploads/reads only; local is
# recommended. S3 has no screenshots, segments, multipart uploads, or deletion.
STORAGE_BACKEND=local

# Where recordings and multipart staging are stored on disk
STORAGE_DIR=./data

# S3-compatible storage. Required when STORAGE_BACKEND=s3.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=recordings
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Use path-style URLs for providers that require them (default: false).
# S3_PATH_STYLE=false

# HTTP listen port and log filter
PORT=8080
RUST_LOG=info

# ffmpeg executable used to mux Instant Mode segments
FFMPEG_PATH=ffmpeg
